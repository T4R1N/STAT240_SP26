knitr::opts_chunk$set(echo = TRUE, message=FALSE, error = TRUE)
library(tidyverse)
filtered_planets <- planets %>%
filter(mass < 1.0 & radius < 1.0) %>%
select(-c(id, star)) %>%
arrange(mass)
print(filtered_planets, n = Inf)
planets <- read_csv("../../data/exoplanets-clean-through-2022.csv")
filtered_planets <- planets %>%
filter(mass < 1.0 & radius < 1.0) %>%
select(-c(id, star)) %>%
arrange(mass)
print(filtered_planets, n = Inf)
knitr::opts_chunk$set(echo = TRUE, message=FALSE, error = TRUE)
library(tidyverse)
filtered_planets <- planets %>%
filter(mass < 1.0 & radius < 1.0) %>%
select(-c(id, star)) %>%
arrange(mass)
print(filtered_planets, n = Inf)
mass_by_year <- planets %>%
filter(!is.na(mass) & !is.na(radius)) %>%
group_by(year) %>%
summarize(n_discovered = n(), minimum_mass = min(mass))
mass_by_year <- planets %>%
filter(!is.na(mass) & !is.na(radius)) %>%
group_by(year) %>%
summarize(n_discovered = n(), minimum_mass = min(mass))
mass_by_year
mass_by_year %>%
ggplot(aes(year, minimum_mass)) +
scale_y_log10() +
geom_point() +
labs(title = "Exoplanet Minimum Mass by Year")
mass_by_year %>%
ggplot(aes(year, minimum_mass)) +
geom_point() +
scale_y_log10() +
labs(title = "Exoplanet Minimum Mass by Year", x = "Year", y = "Minimum Mass")
planet_densities <- planets %>%
mutate(volume = (4/3) * pi * radius ^ 3, density = mass / volume)
sort_by(density)
planet_densities <- planets %>%
mutate(volume = (4/3) * pi * radius ^ 3, density = mass / volume) %>%
arrange(density)
print(planet_densities, n = 5)
planet_densities <- planets %>%
mutate(volume = (4/3) * pi * radius ^ 3, density = mass / volume) %>%
arrange(-density)
print(planet_densities, n = 5)
planets %>%
filter(!is.na(radius) & radius < 40) %>%
ggplot(aes(methods, radius)) +
geom_boxplot()
planets %>%
filter(!is.na(radius) & radius < 40) %>%
ggplot(aes(method, radius)) +
geom_boxplot()
planets %>%
filter(!is.na(radius) & radius < 40) %>%
ggplot(aes(method, radius, color = method)) +
geom_boxplot()
methods_within_year <- planets %>%
filter(year >= 2000) %>%
group_by(year, method) %>%
summarize(method_in_year = n(method)) %>%
arrange(year)
methods_within_year <- planets %>%
filter(year >= 2000) %>%
group_by(year, method) %>%
summarize(method_in_year = n()) %>%
arrange(year)
methods_within_year <- planets %>%
filter(year >= 2000) %>%
group_by(year, method) %>%
summarize(method_in_year = n()) %>%
arrange(year)
print(methods_within_year, n = 20)
methods_within_year <- planets %>%
filter(year >= 2000) %>%
group_by(year, method) %>%
summarize(n = n()) %>%
arrange(year)
print(methods_within_year, n = 20)
# methods_within_year <- methods_within_year %>%
methods_within_year %>%
group_by(year)
summarize(yearTotal = n())
# methods_within_year <- methods_within_year %>%
methods_within_year %>%
group_by(year) %>%
summarize(yearTotal = n())
# methods_within_year <- methods_within_year %>%
methods_within_year %>%
group_by(year) %>%
summarize(yearTotal = sum(n))
# methods_within_year <- methods_within_year %>%
methods_within_year %>%
group_by(year, method, n) %>%
summarize(yearTotal = sum(n))
# methods_within_year <- methods_within_year %>%
methods_within_year %>%
group_by(year) %>%
summarize(yearTotal = sum(n))
# methods_within_year <- methods_within_year %>%
year_total <- methods_within_year %>%
group_by(year) %>%
summarize(yearTotal = sum(n))
methods_within_year <- methods_within_year %>%
left_join(year_total, by = "year")
print(methods_within_year)
methods_within_year_proportions <- methods_within_year %>%
mutate(methodProportion = n / yearTotal)
print(n = 10)
print(methods_within_year_proportions, n = 10)
methods_within_year_proportions %>%
ggplot(aes(year, methodProportion)) +
geom_col(aes(fill = method))
