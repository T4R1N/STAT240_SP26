alpha <- 0.1
qnorm(1 - alpha)
# For example, a 90% CI
alpha <- 0.0001
qnorm(1 - alpha)
# For example, a 90% CI
alpha <- 0.000000000001
qnorm(1 - alpha)
# For example, a 90% CI
alpha <- 0.1
qnorm(1 - alpha)
